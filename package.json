{
  "name": "chip8",
  "version": "1.0.0",
  "description": "chip8 written in TypeScript",
  "main": "src/main/cli.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/main/cli.ts",
    "test": "npx tsc --noEmit && npx eslint . --ext .ts && mocha -r tsx 'src/test/**/*.ts' --exit",
    "format": "npx eslint . --fix --ext .ts",
    "web": "npx tsc --noEmit && node esbuild.config.mjs && cp -r rom/* public/"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "author": "hir-247-30",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/blessed": "^0.1.27",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
